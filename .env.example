# ---------------------------------------------------------------------
# Copy to `.env` and fill in. Only DISCORD_WEBHOOK_URL is required.
# ---------------------------------------------------------------------

# Where alerts are posted. Grab it: Discord channel -> Edit Channel ->
# Integrations -> Webhooks -> Copy Webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-me

# Optional: bot mode (slash commands /price, /status, /scan start).
# Requires `pip install "fourchar-radar[bot]"` + the `bot` extra deps.
# DISCORD_BOT_TOKEN=
# DISCORD_COMMAND_CHANNEL_ID=

# What to scan. `wordlist` (bundled 4-letter words), `bruteforce`
# (every combination), `stdin` (names piped in), or `file`.
RADAR_SOURCE=wordlist
RADAR_LENGTH=4
RADAR_NAMES_FILE=

# Networking / politeness.
# DISCORD_RATE_LIMIT_RPS is a *ceiling*; the adaptive limiter will happily
# sit far below it because the public endpoint is aggressively throttled.
RADAR_RATE_LIMIT_RPS=0.5
RADAR_CONCURRENCY=1
RADAR_TIMEOUT_S=25
RADAR_MAX_RETRIES=3
RADAR_USER_AGENT=fourchar-radar/0.1 (+https://github.com/your-org/fourchar-radar)

# Alerts
RADAR_ALERT_WEBHOOK=true
RADAR_ALERT_MIN_TIER=rare
RADAR_ALERT_COOLDOWN_S=0

# Storage (SQLite): queue + findings live here, so a restart resumes.
RADAR_DB_PATH=state/radar.db

# Logging
RADAR_LOG_LEVEL=INFO
RADAR_LOG_JSON=false